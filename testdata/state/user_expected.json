                    },
                    "errorMessage": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "web.Pet": {
                "properties": {
                    "category": {
                        "properties": {
                            "id": {
                                "example": 1,
                                "type": "integer"
                            },
                            "name": {
                                "example": "category_name",
                                "type": "string"
                            },
                            "photoURLs": {
                                "example": [
                                    "http://test/image/1.jpg",
                                    "http://test/image/2.jpg"
                                ],
                                "items": {
                                    "format": "url",
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            "smallCategory": {
                                "properties": {
                                    "id": {
                                        "example": 1,
                                        "type": "integer"
                                    },
                                    "name": {
                                        "example": "detail_category_name",
                                        "type": "string"
                                    },
                                    "photoURLs": {
                                        "example": [
                                            "http://test/image/1.jpg",
                                            "http://test/image/2.jpg"
                                        ],
                                        "items": {
                                            "type": "string"
                                        },
                                        "type": "array"
                                    }
                                },
                                "type": "object"
                            }
                        },
                        "type": "object"
                    },
                    "data": {},
                    "decimal": {
                        "type": "number"
                    },
                    "id": {
                        "example": 1,
                        "format": "int64",
                        "type": "integer"
                    },
                    "isAlive": {
                        "example": true,
                        "type": "boolean"
                    },
                    "name": {
                        "example": "poti",
                        "type": "string"
                    },
                    "pets": {
                        "items": {
                            "$ref": "#/components/schemas/web.Pet2"
                        },
                        "type": "array"
                    },
                    "pets2": {
                        "items": {
                            "$ref": "#/components/schemas/web.Pet2"
                        },
                        "type": "array"
                    },
                    "photoURLs": {
                        "example": [
                            "http://test/image/1.jpg",
                            "http://test/image/2.jpg"
                        ],
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "price": {
                        "example": 3.25,
                        "multipleOf": 0.01,
                        "type": "number"
                    },
                    "status": {
                        "type": "string"
                    },
                    "tags": {
                        "items": {
                            "$ref": "#/components/schemas/web.Tag"
